# Build trees
cpp/build/
cpp/build_*/
cpp/Testing/
cpp/dist/

# The generated site: 84 pages that tools/gen-site.py rebuilds from source.
/_site/

# tools/check-mermaid.py needs mermaid and jsdom resolvable. CI installs them
# with --no-save; installing them here to check a diagram before pushing should
# not put node_modules in the tree.
/node_modules/
/package-lock.json

# Editors and noise
__pycache__/
*.pyc
.vscode/
.idea/
*~
*.swp
*.log
.env

# Golden-file plan tests write actual output and diffs here on failure, the way
# pg_regress writes results/. They are for looking at, never for committing.
/cpp/test/plans/results/

# Generated by the docker examples: per-shard specs, run-all logs, and the INI
# files each example writes with a password in it.
examples/docker/**/.build/
examples/docker/.*.log
examples/docker/**/keys/
examples/docker/**/*.ini
