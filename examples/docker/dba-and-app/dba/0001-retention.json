{
  "laswell_spec_version": 1,
  "id": "dba-0001-retention",
  "description": "Operational bookkeeping the application does not know about.",
  "rationale": "The DBA's own lineage. The application team never checks this out.",
  "target": {
    "epoch": "dba"
  },
  "intents": [
    {
      "kind": "create_schema",
      "schema": "ops",
      "comment": "Operational objects owned by the DBA."
    },
    {
      "kind": "create_table",
      "schema": "ops",
      "table": "retention_policy",
      "comment": "How long each table's rows are kept.",
      "primary_key": [
        "relname"
      ],
      "columns": [
        {
          "name": "relname",
          "type": "text",
          "nullable": false,
          "comment": "Qualified table name."
        },
        {
          "name": "keep_days",
          "type": "integer",
          "nullable": false,
          "comment": "Retention window."
        }
      ]
    }
  ],
