{
  "laswell_spec_version": 1,
  "id": "0010-accounts",
  "description": "The accounts table, keyed so it can be distributed on id.",
  "rationale": "The primary key includes the distribution column, which Citus requires: uniqueness cannot be enforced across shards without it.",
  "intents": [
    {
      "kind": "create_table",
      "schema": "public",
      "table": "accounts",
      "comment": "Customer accounts.",
      "primary_key": [
        "id"
      ],
      "columns": [
        {
          "name": "id",
          "type": "integer",
          "nullable": false,
          "comment": "Account id, and the distribution column."
        },
        {
          "name": "balance",
          "type": "numeric",
          "nullable": false,
          "comment": "Current balance."
        }
      ]
    }
  ],
