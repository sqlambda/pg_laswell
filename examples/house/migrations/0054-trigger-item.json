{
  "laswell_spec_version": 1,
  "id": "0054-trigger-item",
  "description": "Keep house.item.updated_at true by stamping it on every UPDATE.",
  "rationale": "The trigger fires for rows changed from the commit onwards and for none of the rows already there, which is exactly right here: every existing row was just inserted and its updated_at is already correct.",
  "target": {
    "environment": "dev"
  },
  "depends_on": [
    "0050-fn-touch-updated-at",
    "0030-table-item"
  ],
  "intents": [
    {
      "kind": "create_trigger",
      "schema": "house",
      "table": "item",
      "name": "item_touch_updated_at",
      "timing": "BEFORE",
      "events": [
        "UPDATE"
      ],
      "for_each": "ROW",
      "function": "house.touch_updated_at()"
    }
  ],
  "signatures": [
    {
      "key_id": "ed25519:3fbcbb3b5f464502",
      "algorithm": "ed25519",
      "signature": "6nThAB/Pq5D4FLXM5/ec+1L8ODaC6W89WmyYoMQcZvF4V0GZiHrV7ctYLKtKotEZWwuoAIMELcIwP76TpGvMBw=="
    }
  ]
}
